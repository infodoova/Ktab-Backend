#!/bin/sh
# GitGuardian Pre-Commit Secret Scanner Hook
# Prevents accidental commits of secrets, tokens, and credentials.

# 1. If GitGuardian CLI (ggshield) is installed, delegate to it
if command -v ggshield >/dev/null 2>&1; then
    echo "[GitGuardian] Running ggshield pre-commit secret scan..."
    exec ggshield secret scan pre-commit "$@"
fi

# 2. Fallback lightweight secret scanner for environments without ggshield
echo "[GitGuardian Hook] Scanning staged files for accidental secrets..."

FORBIDDEN_PATTERNS='(sk-[a-zA-Z0-9_-]{32,}|sk_live_[a-zA-Z0-9]+|eyJVc2VySU[a-zA-Z0-9+/=]+|AKIA[0-9A-Z]{16}|-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----|AIza[0-9A-Za-z\-_]{35})'

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -vE '(\.env\.example|\.env\.schema|docs/|\.gitguardian\.yaml)$')

if [ -n "$STAGED_FILES" ]; then
    MATCHES=$(git diff --cached -S"sk-" -S"AIza" -S"eyJVc2VySU" -S"PRIVATE KEY" $STAGED_FILES 2>/dev/null)
    
    # Check staged content against forbidden patterns
    FOUND=0
    for file in $STAGED_FILES; do
        if git show ":$file" 2>/dev/null | grep -E -q "$FORBIDDEN_PATTERNS"; then
            echo "❌ [GitGuardian ERROR] Potential secret detected in staged file: $file"
            FOUND=1
        fi
    done

    if [ "$FOUND" -eq 1 ]; then
        echo ""
        echo "================================================================================"
        echo "🛑 COMMIT REJECTED BY GITGUARDIAN POLICY"
        echo "High-entropy secrets or private keys were detected in your staged files."
        echo "Please remove the secrets, move them to .env.development / .env.production,"
        echo "and stage only sanitized code before committing."
        echo "================================================================================"
        exit 1
    fi
fi

echo "✅ [GitGuardian] Secret pre-commit scan passed."
exit 0
