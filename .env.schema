# ==============================================================================
# KTAB BACKEND - ENVFORGE ENVIRONMENT SCHEMA (.env.schema)
# Defines types, defaults, and requirements for IntelliJ EnvForge IDE integration.
# ==============================================================================

# --- Spring Application & Server ---

[SPRING_PROFILES_ACTIVE]
type = "enum"
options = ["development", "local", "production"]
required = false
default = "development"
description = "Active Spring Boot profile"

[PORT]
type = "port"
required = false
default = "8080"
description = "HTTP server listening port"

# --- Database (PostgreSQL) ---

[SPRING_DATASOURCE_URL]
type = "string"
required = false
default = "jdbc:postgresql://localhost:5432/ktab"
description = "Full JDBC URL for PostgreSQL database connection"

[SPRING_DATASOURCE_USERNAME]
type = "string"
required = false
default = "postgres"
description = "Database username"

[SPRING_DATASOURCE_PASSWORD]
type = "string"
required = false
sensitive = true
description = "Database password"

[DB_HOST]
type = "string"
required = false
default = "localhost"
description = "Database host address (used by Render blueprint)"

[DB_PORT]
type = "port"
required = false
default = "5432"
description = "Database port"

[DB_NAME]
type = "string"
required = false
default = "ktab"
description = "PostgreSQL database name"

[DB_USER]
type = "string"
required = false
default = "postgres"
description = "Database user"

[DB_PASSWORD]
type = "string"
required = false
sensitive = true
description = "Database user password"

# --- Security & JWT Authentication ---

[JWT_SECRET]
type = "string"
required = true
sensitive = true
description = "Base64-encoded 256-bit secret key for signing JWT tokens"

[JWT_REFRESH_EXPIRATION_MS]
type = "number"
required = false
default = "604800000"
description = "Refresh token expiration duration in milliseconds (7 days)"

[GOOGLE_CLIENT_ID]
type = "string"
required = false
description = "Google OAuth 2.0 Client ID for social authentication"

# --- Mail (SMTP) ---

[MAIL_USERNAME]
type = "email"
required = false
description = "SMTP email username for verification and password reset emails"

[MAIL_PASSWORD]
type = "string"
required = false
sensitive = true
description = "SMTP application password"

# --- AI & External Services ---

[OPENAI_API_KEY]
type = "string"
required = false
sensitive = true
description = "OpenAI API key for Spring AI models (GPT-4o)"

[GCP_PROJECT_ID]
type = "string"
required = false
default = "ktab-prod"
description = "Google Cloud Project ID for Vertex AI / Gemini"

[ELEVENLABS_API_KEY]
type = "string"
required = false
sensitive = true
description = "ElevenLabs API key for Text-to-Speech audio generation"

# --- CORS & Cookies ---

[CORS_ALLOWED_ORIGINS]
type = "string"
required = false
default = "http://localhost:3000,http://localhost:4200,http://localhost:5173"
description = "Comma-separated allowed origins for CORS headers"

[COOKIE_SAME_SITE]
type = "enum"
options = ["Lax", "Strict", "None"]
required = false
default = "Lax"
description = "SameSite cookie policy"

[COOKIE_REFRESH_MAX_AGE_SECONDS]
type = "number"
required = false
default = "604800"
description = "Max age in seconds for refresh token cookies"

# --- Cloudflare R2 Object Storage ---

[CF_ACCOUNT_ID]
type = "string"
required = true
description = "Cloudflare 32-character hexadecimal Account ID"

[CF_R2_ACCESS_KEY]
type = "string"
required = true
description = "Cloudflare R2 API Token Access Key ID"

[CF_R2_SECRET_KEY]
type = "string"
required = true
sensitive = true
description = "Cloudflare R2 API Token Secret Access Key"

[CF_R2_BUCKET_NAME]
type = "string"
required = false
default = "ktab-bucket"
description = "Cloudflare R2 bucket name"

[CF_R2_PUBLIC_URL]
type = "url"
required = false
description = "Public CDN domain or r2.dev subdomain for assets"

# --- Upstash QStash Message Queue ---

[QSTASH_URL]
type = "url"
required = false
default = "https://qstash-eu-central-1.upstash.io"
description = "Upstash QStash REST API base endpoint"

[QSTASH_TOKEN]
type = "string"
required = false
sensitive = true
description = "Upstash QStash REST API Bearer token"

[QSTASH_CURRENT_SIGNING_KEY]
type = "string"
required = false
sensitive = true
description = "Upstash QStash webhook current signing key (HS256)"

[QSTASH_NEXT_SIGNING_KEY]
type = "string"
required = false
sensitive = true
description = "Upstash QStash webhook next signing key for zero-downtime rotation"

[APP_BASE_URL]
type = "url"
required = false
default = "http://localhost:8080"
description = "Public HTTPS URL of this backend API for QStash push callbacks"

[QSTASH_OCR_WORKER_ENABLED]
type = "bool"
required = false
default = "false"
description = "Enable distributed OCR via QStash push webhooks"

[QSTASH_VERIFY_SIGNATURE]
type = "bool"
required = false
default = "false"
description = "Verify cryptographic Upstash-Signature on incoming webhooks"
