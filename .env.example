###############################################################################
# KTAB BACKEND - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env or .env.development or .env.production and fill in your secrets.
###############################################################################

# --- Spring Application ---
SPRING_PROFILES_ACTIVE=local
PORT=8080

# --- Database ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ktab
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ktab
DB_USER=postgres
DB_PASSWORD=your_database_password

# --- Security / JWT ---
JWT_SECRET=your_256bit_base64_jwt_secret
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Mail (SMTP) ---
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# --- AI APIs ---
OPENAI_API_KEY=your_openai_api_key
GCP_PROJECT_ID=ktab-prod
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id

# --- CORS & Cookies ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173
COOKIE_SAME_SITE=Lax

###############################################################################
# CLOUDFLARE R2 STORAGE
###############################################################################
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_R2_ACCESS_KEY=your_r2_access_key_id
CF_R2_SECRET_KEY=your_r2_secret_access_key
CF_R2_BUCKET_NAME=ktab-bucket
CF_R2_PUBLIC_URL=

###############################################################################
# UPSTASH QSTASH (QUEUE)
###############################################################################
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key
QSTASH_NEXT_SIGNING_KEY=
APP_BASE_URL=http://localhost:8080
QSTASH_OCR_WORKER_ENABLED=false
QSTASH_VERIFY_SIGNATURE=false
